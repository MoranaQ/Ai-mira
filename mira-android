name: Build Android APK

on:
  push:
    branches: ["main", "master"]
  pull_request:
    branches: ["main", "master"]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Locate Android project
        id: android-project
        shell: bash
        run: |
          set -euo pipefail

          if [[ -f "mira-android-companion-project.zip" ]]; then
            echo "ZIP file found, extracting..."
            unzip -q mira-android-companion-project.zip -d .
          fi

          gradlew_path="$(find . -type f -name gradlew -not -path './.git/*' -print -quit)"

          if [[ -z "$gradlew_path" ]]; then
            echo "::error::No Gradle wrapper found in the repository."
            echo "Check for project structure:"
            find . -maxdepth 4 \( -name "gradlew" -o -name "settings.gradle" -o -name "settings.gradle.kts" -o -name "build.gradle" -o -name "build.gradle.kts" \) | sort
            exit 1
          fi

          project_dir="$(dirname "$gradlew_path")"
          echo "project-dir=$project_dir" >> "$GITHUB_OUTPUT"
          echo "Found Gradle wrapper at: $gradlew_path"

      - name: Build Debug APK
        working-directory: ${{ steps.android-project.outputs.project-dir }}
        run: |
          chmod +x ./gradlew
          ./gradlew assembleDebug --stacktrace

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: app-debug
          path: |
            **/build/outputs/apk/**/app-*.apk
          if-no-files-found: warn
